# Material bake output. Written in the target's block format (BC1/BC5/BC7), so it is
# regenerated per platform from Data/textures_src/ rather than shared.
/Data/Textures/

# VAT bake output. Wholly derived from the .bmesh/.bskel/.banim it stamps and re-baked on
# demand when any of them changes, so it is never committed.
*.bvat
