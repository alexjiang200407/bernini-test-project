* text=auto

# Authored documents: canonical JSON, and diffing and merging them is the point. LF on every
# platform, because the writers emit LF and `assetlib_cli migrate` byte-compares -- an autocrlf
# checkout would otherwise re-report every one of them on every run.
*.berniniproject text eol=lf
*.bimport        text eol=lf
*.bmaterial      text eol=lf
*.benv           text eol=lf

# Everything else committed here is bytes: the glTF sources, the GPU-compressed textures, and
# the derived containers .gitignore does not cover. None of them diff or merge.
*.glb   binary
*.ktx2  binary
*.bsky  binary
*.benvl binary
